# Copy variable names into your shell or GitHub Actions Secrets/Variables.
# Never put real credentials in this file.
DELIVERY_PROVIDER=serverchan
SERVERCHAN_SENDKEY=replace-with-your-serverchan-sendkey

# Optional: raises GitHub API rate limits.
GITHUB_TOKEN=

# Optional OpenAI-compatible Chinese summary service.
SUMMARY_API_BASE=https://api.openai.com/v1
SUMMARY_API_KEY=
SUMMARY_MODEL=gpt-4o-mini

# Optional runtime tuning.
DATA_DIR=data
HTTP_TIMEOUT_SECONDS=20
FALLBACK_MAX_AGE_HOURS=12

